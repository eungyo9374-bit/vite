# 이 파일을 복사해서 .env 로 만들고 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# Supabase  >  Project Settings > API (또는 Connect 버튼)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...(anon public key 또는 publishable key)

# Pixabay  >  https://pixabay.com/api/docs/ 로그인 후 "Your API key"
# VITE_ 접두사가 없으므로 브라우저에 노출되지 않고 서버(api/pixabay.js)에서만 사용됩니다.
PIXABAY_API_KEY=
